--- !u!114 &359337350
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 359337349}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 694c8a0cf987a41459567fe358f804e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MainMenuTutorial
  steps:
  - targetButton: {fileID: 0}
    tooltipText: "Welcome to EnduroRace. This is a triathlon game where you\u2019ll
      compete in swimming, cycling, and running events. Each segment has its own
      controls and challenges, so timing and stamina management are key. You\u2019ll
      face obstacles, terrain changes, and other racers along the way. For now, let\u2019s
      get you started with the basics."
    sceneToLoad: 
    spotlightRect: {fileID: 0}
    voiceClip: {fileID: 8300000, guid: 8fec7d4d7e874b14198f469b5510ec75, type: 3}
  - targetButton: {fileID: 2057135496}
    tooltipText: This is your Profile. Set your display name, pick your avatar, and
      choose your athlete model.
    sceneToLoad: Profile
    spotlightRect: {fileID: 392221126}
    voiceClip: {fileID: 8300000, guid: ada1d1bd10e6add47afaf887aaa11714, type: 3}
  - targetButton: {fileID: 1085533965}
    tooltipText: Visit the Shop to spend coins you collect during races on new gear
      and cosmetics.
    sceneToLoad: Shop
    spotlightRect: {fileID: 1228114247}
    voiceClip: {fileID: 8300000, guid: 555c3595f09bc2f4cbc9aa6ade7dd579, type: 3}
  - targetButton: {fileID: 2137667390}
    tooltipText: Check the Leaderboards to see how you rank and unlock Achievements
      by completing milestones.
    sceneToLoad: LeaderboardsAchievementsScene
    spotlightRect: {fileID: 853248985}
    voiceClip: {fileID: 8300000, guid: ff9bc94f4fbd71c4fbb69d27d2631ef9, type: 3}
  - targetButton: {fileID: 1450066732}
    tooltipText: Adjust audio, graphics, and controls in Settings to fit your play
      style.
    sceneToLoad: Settings
    spotlightRect: {fileID: 494632357}
    voiceClip: {fileID: 8300000, guid: 6e1de2db50cb31442bd15d287d3e9e1a, type: 3}
  - targetButton: {fileID: 1335064659}
    tooltipText: Finally, tap Tutorial to learn the race controls before your first
      race!
    sceneToLoad: Tutorial
    spotlightRect: {fileID: 414133314}
    voiceClip: {fileID: 8300000, guid: 1c1e874fd1a126a4f9b470743777b044, type: 3}
  overlay: {fileID: 1550231122}
  tooltipPanel: {fileID: 1084933623}
  tooltipText: {fileID: 1681834971}
  tapToContinueText: {fileID: 1421663685}
  audioSource: {fileID: 2126159097}
